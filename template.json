{
  "version": 3,
  "services": {
    "backend": {
      "name": "backend",
      "source": {
        "rootDirectory": "backend"
      },
      "env": {
        "MONGO_URI": "${{MONGODB_URL}}",
        "JWT_SECRET": "secret_key_${{RAILWAY_PROJECT_ID}}",
        "PORT": "5000",
        "NODE_ENV": "production"
      }
    },
    "frontend": {
      "name": "frontend",
      "source": {
        "rootDirectory": "frontend"
      },
      "env": {
        "VITE_API_URL": "https://${{backend.RAILWAY_STATIC_URL}}/api"
      }
    }
  },
  "databases": {
    "mongodb": {
      "type": "MONGODB"
    }
  }
}
